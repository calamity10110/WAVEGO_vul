{
  "meta": {
    "project": "Waveshare WAVEGO Pro - ESP32 Lower-Computer JSON Command Interface",
    "source_of_truth": [
      "wavego_pro_platformio/WAVEGO_Pro_PlatformIO/src/Config.h (command ID definitions)",
      "wavego_pro_platformio/WAVEGO_Pro_PlatformIO/src/main.cpp (jsonCmdReceiveHandler dispatcher)",
      "wavego_pro_platformio/WAVEGO_Pro_PlatformIO/src/BodyCtrl.cpp/.h (motion)",
      "wavego_pro_platformio/WAVEGO_Pro_PlatformIO/src/RGBLight.cpp/.h (RGB LEDs)",
      "wavego_pro_platformio/WAVEGO_Pro_PlatformIO/src/ScreenCtrl.cpp/.h (OLED)",
      "wavego_pro_platformio/WAVEGO_Pro_PlatformIO/src/web_page.h (web UI senders)"
    ],
    "transport": [
      {
        "type": "UART serial",
        "format": "One JSON object per line, newline-terminated",
        "baud": 115200,
        "note": "Used by Raspberry Pi upper computer (ugv_rpi app.py: /dev/ttyAMA0 or /dev/serial0 @115200)"
      },
      {
        "type": "HTTP GET",
        "format": "http://<ip>/js?json=<url-encoded-json>",
        "ip_ap_mode": "192.168.4.1 (ESP32-only AP 'WAVEGO')",
        "note": "Web UI (web_page.h) uses this endpoint; response body = JSON feedback string"
      },
      {
        "type": "ESP-NOW",
        "note": "Peer JSON payloads are routed into the same jsonCmdReceiveHandler when espnowInit is active"
      }
    ],
    "command_envelope": "Every command is a JSON object with mandatory integer field 'T' (command type). Optional fields depend on T.",
    "assembly_mode": "Servo-level commands (T:102, T:103) require assembly/debug mode: G12/DEBUG_PIN pulled HIGH (jumper G12 to 3V3).",
    "servo_id_map": {
      "joint_index_0_11": [
        53,
        52,
        51,
        41,
        42,
        43,
        23,
        22,
        21,
        31,
        32,
        33
      ],
      "layout": {
        "front_left_leg": "joints [0]=LF_A, [1]=LF_B, [2]=LF_H (servos 53,52,51)",
        "hind_left_leg": "joints [3]=LH_A, [4]=LH_B, [5]=LH_H (servos 41,42,43)",
        "front_right_leg": "joints [6]=RF_A, [7]=RF_B, [8]=RF_H (servos 23,22,21)",
        "hind_right_leg": "joints [9]=RH_A, [10]=RH_B, [11]=RH_H (servos 31,32,33)"
      },
      "leg_numbering_single_leg_ctrl": {
        "1": "front-left",
        "2": "hind-left",
        "3": "front-right",
        "4": "hind-right"
      },
      "position_range": "0..1023, middle/zero = 511"
    }
  },
  "commands": {
    "body_motion": [
      {
        "T": 1,
        "cmd": "CMD_UGV_CTRL",
        "description": "Differential-drive style vector input, converted to gait direction (compat layer for generic Waveshare UGV upper computers).",
        "payload": {
          "L": "float left speed (sign = direction)",
          "R": "float right speed (sign = direction)"
        },
        "handler": "main.cpp -> BodyCtrl::ugvCtrl(L, R)",
        "example": {
          "T": 1,
          "L": 0.5,
          "R": 0.5
        },
        "notes": "L==R>0 -> forward; L==R<0 -> backward; L==-R -> turn in place; mixed signs -> diagonal gait direction."
      },
      {
        "T": 101,
        "cmd": "CMD_JOINT_MIDDLE",
        "description": "Move all 12 joints to mid position (511).",
        "payload": {},
        "handler": "main.cpp -> BodyCtrl::jointMiddle()",
        "example": {
          "T": 101
        }
      },
      {
        "T": 102,
        "cmd": "CMD_RELEASE_TORQUE",
        "description": "Release torque lock on all servos (limp).",
        "payload": {},
        "handler": "main.cpp -> BodyCtrl::releaseTorque()",
        "example": {
          "T": 102
        },
        "notes": "Assembly mode only (G12 to 3V3)."
      },
      {
        "T": 103,
        "cmd": "CMD_SINGLE_SERVO_CTRL",
        "description": "Drive one bus servo directly to a raw position.",
        "payload": {
          "id": "u8 servo ID (e.g. 21..53)",
          "goal": "int target position 0..1023",
          "time": "int ms to reach goal (used when spd=0)",
          "spd": "int speed (0 = use time)"
        },
        "handler": "main.cpp -> BodyCtrl::singleServoCtrl(id, goal, time, spd)",
        "example": {
          "T": 103,
          "id": 21,
          "goal": 511,
          "time": 0,
          "spd": 0
        },
        "notes": "Assembly mode only (G12 to 3V3). Not recommended for locomotion after assembly - use T:111."
      },
      {
        "T": 104,
        "cmd": "CMD_GET_JOINTS_ZERO",
        "description": "Get the zero-position array of all 12 joints (printed to serial).",
        "payload": {},
        "handler": "main.cpp -> BodyCtrl::getJointsZeroPosArray()",
        "example": {
          "T": 104
        },
        "response": "12 lines 'Joint <i>: <pos>' on serial."
      },
      {
        "T": 105,
        "cmd": "CMD_SET_JOINTS_ZERO",
        "description": "Set the zero-position array of all 12 joints.",
        "payload": {
          "set": "int[12] zero positions, each ~0..1023"
        },
        "handler": "main.cpp -> BodyCtrl::setJointsZeroPosArray(set[])",
        "example": {
          "T": 105,
          "set": [
            511,
            511,
            511,
            511,
            511,
            511,
            511,
            511,
            511,
            511,
            511,
            511
          ]
        },
        "notes": "Persisted calibration; also written into the 'boot' mission by T:107."
      },
      {
        "T": 106,
        "cmd": "CMD_GET_CURRENT_POS",
        "description": "Read current position feedback of all 12 servos.",
        "payload": {},
        "handler": "main.cpp -> BodyCtrl::getServoFeedback()",
        "example": {
          "T": 106
        },
        "response": {
          "T": -106,
          "fb": "int[12] current positions"
        }
      },
      {
        "T": 107,
        "cmd": "CMD_SET_CURRENT_POS_ZERO",
        "description": "Calibrate: store current physical positions of all joints as the new zero positions.",
        "payload": {},
        "handler": "main.cpp -> BodyCtrl::setCurrentPosZero()",
        "example": {
          "T": 107
        },
        "response": {
          "T": 105,
          "set": "int[12] new zero array (also appended to 'boot' mission in LittleFS)"
        }
      },
      {
        "T": 108,
        "cmd": "CMD_CTRL_JOINT_ANGLE",
        "description": "Move a single joint to an angle (degrees), then trigger interpolation.",
        "payload": {
          "joint": "int joint index 0..11",
          "angle": "double target angle in degrees"
        },
        "handler": "main.cpp -> BodyCtrl::jointAngle(joint, angle) + moveTrigger()",
        "example": {
          "T": 108,
          "joint": 1,
          "angle": 45
        }
      },
      {
        "T": 109,
        "cmd": "CMD_CTRL_JOINT_RAD",
        "description": "Move a single joint to an angle (radians), then trigger interpolation.",
        "payload": {
          "joint": "int joint index 0..11",
          "rad": "double target angle in radians"
        },
        "handler": "main.cpp -> BodyCtrl::jointRad(joint, rad) + moveTrigger()",
        "example": {
          "T": 109,
          "joint": 1,
          "rad": 0.785
        }
      },
      {
        "T": 110,
        "cmd": "CMD_STAND_UP",
        "description": "Stand up at default height (STAND_HEIGHT = 95).",
        "payload": {},
        "handler": "main.cpp -> BodyCtrl::stand()",
        "example": {
          "T": 110
        }
      },
      {
        "T": 111,
        "cmd": "CMD_BASIC_MOVE",
        "description": "Primary locomotion vector command - starts/steers the triangular gait engine.",
        "payload": {
          "FB": "int -1 | 0 | +1 (forward/backward component)",
          "LR": "int -1 | 0 | +1 (left/right strafe or turn component)"
        },
        "handler": "main.cpp -> BodyCtrl::inputCmd(FB, LR); consumed by robotCtrl() loop",
        "example": {
          "T": 111,
          "FB": 1,
          "LR": 0
        },
        "gait_direction_map": {
          "FB=1,LR=0": "forward (0 deg)",
          "FB=-1,LR=0": "backward (180 deg)",
          "FB=1,LR=-1": "forward-left (30 deg)",
          "FB=1,LR=1": "forward-right (-30 deg)",
          "FB=-1,LR=1": "back-right (-120 deg)",
          "FB=-1,LR=-1": "back-left (120 deg)",
          "FB=0,LR=-1": "turn left (turnCmd=-1)",
          "FB=0,LR=1": "turn right (turnCmd=1)",
          "FB=0,LR=0": "stop -> stand at mass center"
        },
        "notes": "Values beyond -1/0/1 are also accepted by the web UI (analog joystick) but the reference UI uses -1/0/1."
      },
      {
        "T": 112,
        "cmd": "CMD_BASIC_FUNC",
        "description": "Trigger built-in demo functions / balancing mode.",
        "payload": {
          "func": "int selector: 1=StayLow, 2=HandShake, 3=Jump, 4=steady START, 5=steady STOP"
        },
        "handler": "main.cpp switch -> BodyCtrl::functionStayLow/Handshake/Jump; steadyMode flag + BodyCtrl::standUp(95) on stop",
        "example": {
          "T": 112,
          "func": 2
        },
        "notes": "func=4 enables IMU self-balancing loop (main loop: accXYZUpdate + BodyCtrl::balancing(ACC_X, ACC_Y) using ICM20948); func=5 disables and returns to stand."
      },
      {
        "T": 113,
        "cmd": "CMD_SINGLE_LEG_CTRL",
        "description": "Move one leg tip to a cartesian target (debug/advanced).",
        "payload": {
          "leg": "u8 leg 1..4",
          "x": "double mm forward axis",
          "y": "double mm height axis",
          "z": "double mm lateral axis"
        },
        "handler": "main.cpp -> BodyCtrl::singleLegCtrl(leg, x, y, z) + moveTrigger()",
        "example": {
          "T": 113,
          "leg": 1,
          "x": 16,
          "y": 90,
          "z": 25
        }
      },
      {
        "T": 114,
        "cmd": "CMD_STAND_UP_HEIGHT",
        "description": "Stand at an explicit body height.",
        "payload": {
          "h": "double height in mm (clamped by WALK_HEIGHT_MIN..MAX, default 75..110)"
        },
        "handler": "main.cpp -> BodyCtrl::standUp(h)",
        "example": {
          "T": 114,
          "h": 95
        }
      },
      {
        "T": 115,
        "cmd": "CMD_SET_INTERPOLATION_PARAMS",
        "description": "Tune gait/interpolation timing.",
        "payload": {
          "delay": "int ms delay per gait iteration (default 5)",
          "iterate": "float global step increment per iteration (default 0.02, range 0..1)"
        },
        "handler": "main.cpp -> BodyCtrl::setInterpolationParams(delay, iterate)",
        "example": {
          "T": 115,
          "delay": 5,
          "iterate": 0.02
        }
      },
      {
        "T": 116,
        "cmd": "CMD_SET_GAIT_PARAMS",
        "description": "Tune all gait geometry parameters.",
        "payload": {
          "maxHeight": "double (default 110)",
          "minHeight": "double (default 75)",
          "height": "double standing height (default 95)",
          "lift": "double swing lift (default 9; height+lift <= maxHeight)",
          "range": "double stride range (default 40)",
          "acc": "double acceleration component (default 5)",
          "extendedX": "double default leg x offset (default 16)",
          "extendedZ": "double default leg z offset (default 25)",
          "sideMax": "double lateral limit (default 30)",
          "massAdjust": "double mass-center adjust (default 21)"
        },
        "handler": "main.cpp -> BodyCtrl::setGaitParams(...)",
        "example": {
          "T": 116,
          "maxHeight": 110,
          "minHeight": 75,
          "height": 95,
          "lift": 9,
          "range": 40,
          "acc": 5,
          "extendedX": 16,
          "extendedZ": 25,
          "sideMax": 30,
          "massAdjust": 21
        }
      },
      {
        "T": 133,
        "cmd": "CMD_PT_CTRL",
        "description": "Pan-tilt style body pose command (compat with UGV gimbal UI): maps X/Y onto body pitch/yaw posture.",
        "payload": {
          "X": "float -180..180 -> yaw -30..+30 deg",
          "Y": "float -30..30 -> pitch -17.5..+17.5 deg"
        },
        "handler": "main.cpp -> BodyCtrl::ptCtrl(X, Y) -> pitchYawRoll(pitch, yaw, 0)",
        "example": {
          "T": 133,
          "X": 0,
          "Y": 0
        }
      }
    ],
    "rgb_light": [
      {
        "T": 201,
        "cmd": "CMD_SET_COLOR",
        "description": "Set color of one RGB LED (2x WS2812/NeoPixel on GPIO26).",
        "payload": {
          "set": "int[4] = [id, r, g, b]; id: 0=left LED, 1=right LED; r/g/b: 0..255"
        },
        "handler": "main.cpp -> RGBLight::setColor(id, r, g, b) (Adafruit_NeoPixel, NEO_GRB + NEO_KHZ800)",
        "example": {
          "T": 201,
          "set": [
            0,
            9,
            0,
            0
          ]
        },
        "notes": "Firmware quirk: RGBLight.cpp calls pixels.Color(g, r, b), so the red and green channels are swapped on the physical strip. Boot colors: LED0=(255,0,64), LED1=(64,0,255); assembly mode: both orange (255,64,0)."
      }
    ],
    "screen_oled": [
      {
        "T": 202,
        "cmd": "CMD_DISPLAY_SINGLE",
        "description": "Write one of the 4 text lines on the 128x32 SSD1306 OLED (I2C 0x3C).",
        "payload": {
          "line": "int 1..4",
          "text": "string content of the line",
          "update": "bool 1=refresh panel now, 0=buffer only"
        },
        "handler": "main.cpp -> ScreenCtrl::changeSingleLine(line, text, update)",
        "example": {
          "T": 202,
          "line": 1,
          "text": "Hello, world!",
          "update": 1
        }
      },
      {
        "T": 203,
        "cmd": "CMD_DISPLAY_UPDATE",
        "description": "Refresh the OLED with the currently buffered 4 lines.",
        "payload": {},
        "handler": "main.cpp -> ScreenCtrl::updateFrame()",
        "example": {
          "T": 203
        }
      },
      {
        "T": 204,
        "cmd": "CMD_DISPLAY_FRAME",
        "description": "Write all 4 lines at once and refresh.",
        "payload": {
          "l1": "string line 1",
          "l2": "string line 2",
          "l3": "string line 3",
          "l4": "string line 4"
        },
        "handler": "main.cpp -> 4x changeSingleLine(...) with final update=true",
        "example": {
          "T": 204,
          "l1": "Hello, world!",
          "l2": "Hello, world!",
          "l3": "Hello, world!",
          "l4": "Hello, world!"
        },
        "notes": "4 lines x 8px at text size 1; ~21 chars per line fit the 128px width."
      },
      {
        "T": 205,
        "cmd": "CMD_DISPLAY_CLEAR",
        "description": "Clear the OLED.",
        "payload": {},
        "handler": "main.cpp -> ScreenCtrl::clearDisplay()",
        "example": {
          "T": 205
        }
      }
    ],
    "buzzer": [
      {
        "T": 206,
        "cmd": "CMD_BUZZER_CTRL",
        "description": "Active buzzer beep (GPIO21).",
        "payload": {
          "freq": "int frequency in Hz",
          "duration": "int duration in ms (blocking)"
        },
        "handler": "main.cpp -> buzzerCtrl(freq, duration) (tone/noTone)",
        "example": {
          "T": 206,
          "freq": 1000,
          "duration": 10
        }
      }
    ],
    "power": [
      {
        "T": 207,
        "cmd": "CMD_GET_BATTERY_VOLTAGE",
        "description": "Read battery voltage via INA219 (I2C 0x42).",
        "payload": {},
        "handler": "main.cpp -> InaDataUpdate()",
        "example": {
          "T": 207
        },
        "response": {
          "T": -207,
          "voltage": "float load voltage in V (2S 18650: ~6.4-8.4 V)"
        }
      }
    ],
    "files_missions": [
      {
        "T": 300,
        "cmd": "CMD_SCAN_FILES",
        "description": "List all mission files in LittleFS (printed to serial).",
        "payload": {},
        "handler": "main.cpp -> FilesCtrl::scan()",
        "example": {
          "T": 300
        }
      },
      {
        "T": 301,
        "cmd": "CMD_CREATE_MISSION",
        "description": "Create a mission file (/name.mission).",
        "payload": {
          "name": "string mission name",
          "intro": "string description comment"
        },
        "handler": "main.cpp -> FilesCtrl::createMission(name, intro)",
        "example": {
          "T": 301,
          "name": "mission1",
          "intro": "introduction for this mission file."
        }
      },
      {
        "T": 302,
        "cmd": "CMD_MISSION_CONTENT",
        "description": "Print the content of a mission file (each step is one JSON command).",
        "payload": {
          "name": "string mission name"
        },
        "handler": "main.cpp -> FilesCtrl::missionContent(name)",
        "example": {
          "T": 302,
          "name": "boot"
        }
      },
      {
        "T": 303,
        "cmd": "CMD_APPEND_SETP_JSON",
        "description": "Append a JSON command as a new step at the end of a mission.",
        "payload": {
          "name": "string mission name",
          "json": "string containing a full command JSON"
        },
        "handler": "main.cpp -> FilesCtrl::appendStep(name, json)",
        "example": {
          "T": 303,
          "name": "boot",
          "json": "{\"T\":201,\"set\":[0,9,0,0]}"
        }
      },
      {
        "T": 304,
        "cmd": "CMD_INSERT_SETP_JSON",
        "description": "Insert a JSON command step before the given step number.",
        "payload": {
          "name": "string mission name",
          "step": "int step number (1-based)",
          "json": "string command JSON"
        },
        "handler": "main.cpp -> FilesCtrl::insertStep(name, step, json)",
        "example": {
          "T": 304,
          "name": "boot",
          "step": 2,
          "json": "{\"T\":201,\"set\":[0,9,0,0]}"
        }
      },
      {
        "T": 305,
        "cmd": "CMD_REPLACE_SETP_JSON",
        "description": "Replace the JSON command at a given step number.",
        "payload": {
          "name": "string mission name",
          "step": "int step number (1-based)",
          "json": "string command JSON"
        },
        "handler": "main.cpp -> FilesCtrl::replaceStep(name, step, json)",
        "example": {
          "T": 305,
          "name": "boot",
          "step": 2,
          "json": "{\"T\":201,\"set\":[0,9,0,0]}"
        }
      },
      {
        "T": 306,
        "cmd": "CMD_DELETE_SETP",
        "description": "Delete one step from a mission.",
        "payload": {
          "name": "string mission name",
          "step": "int step number (1-based)"
        },
        "handler": "main.cpp -> FilesCtrl::deleteStep(name, step)",
        "example": {
          "T": 306,
          "name": "boot",
          "step": 2
        }
      },
      {
        "T": 307,
        "cmd": "CMD_RUN_STEP",
        "description": "Execute a single mission step immediately.",
        "payload": {
          "name": "string mission name",
          "step": "int step number (1-based)"
        },
        "handler": "main.cpp -> runStep(name, step) -> jsonCmdReceiveHandler",
        "example": {
          "T": 307,
          "name": "boot",
          "step": 2
        },
        "notes": "Coupling function: the step itself is a full command JSON."
      },
      {
        "T": 308,
        "cmd": "CMD_RUN_MISSION",
        "description": "Execute a whole mission, looping.",
        "payload": {
          "name": "string mission name",
          "interval": "int ms delay between steps (50 ms internal time offset subtracted)",
          "loop": "int loop count (-1 = infinite)"
        },
        "handler": "main.cpp -> runMission(name, interval, loop)",
        "example": {
          "T": 308,
          "name": "boot",
          "interval": 1000,
          "loop": 1
        },
        "notes": "Blocking; incoming serial data aborts the mission loop."
      },
      {
        "T": 309,
        "cmd": "CMD_DELETE_MISSION",
        "description": "Delete a mission file.",
        "payload": {
          "name": "string mission name"
        },
        "handler": "main.cpp -> FilesCtrl::deleteMission(name)",
        "example": {
          "T": 309,
          "name": "boot"
        }
      },
      {
        "T": 399,
        "cmd": "CMD_FORMAT_FLASH",
        "description": "Format LittleFS (wipes ALL missions, including 'boot' WiFi/calibration config).",
        "payload": {},
        "handler": "main.cpp -> FilesCtrl::flash() -> LittleFS.format()",
        "example": {
          "T": 399
        }
      }
    ],
    "wireless_wifi": [
      {
        "T": 400,
        "cmd": "CMD_SET_WIFI_MODE",
        "description": "Configure WiFi AP and/or STA credentials; result is persisted into the 'boot' mission (auto-applied at power-on).",
